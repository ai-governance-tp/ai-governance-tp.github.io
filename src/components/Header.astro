---
import { TYPY } from '../lib/zapisnice';

const NAV = [
  { href: '/', label: 'Domov' },
  { href: '/zadanie/', label: 'Zadanie' },
  { href: '/tim/', label: 'Tím' },
  { href: '/zapisnice/', label: 'Zápisnice', menu: true },
  { href: '/dokumentacia/', label: 'Dokumentácia' },
];

const MENU = [
  { href: TYPY.veduci.cesta, label: TYPY.veduci.kratky },
  { href: TYPY.tim.cesta, label: TYPY.tim.kratky },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container site-header__top">
    <a class="brand" href="/">
      <img src="/logo.png" alt="" width="48" height="48" />
      <span class="brand__text">
        <span class="brand__name">AI Governance</span>
        <span class="brand__sub">Tímový projekt · FEI STU 2026/2027</span>
      </span>
    </a>
    <a class="repo" href="https://github.com/ai-governance-tp/ai-governance-tp.github.io" target="_blank" rel="noopener">
      <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
        <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
      </svg>
      <span>GitHub</span>
    </a>
  </div>
  <nav class="site-nav" aria-label="Hlavná navigácia">
    <ul>
      {NAV.map((item) =>
        item.menu ? (
          <li class="has-menu">
            <button
              type="button"
              class:list={['nav-btn', { active: isActive(item.href) }]}
              aria-expanded="false"
              aria-controls="menu-zapisnice"
            >
              {item.label}
              <svg class="caret" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="m4 6 4 4 4-4"/></svg>
            </button>
            <div class="menu" id="menu-zapisnice" hidden>
              {MENU.map((m) => (
                <a href={m.href} class:list={['menu__item', { active: path.startsWith(m.href) }]}>{m.label}</a>
              ))}
            </div>
          </li>
        ) : (
          <li>
            <a href={item.href} class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        )
      )}
    </ul>
  </nav>
</header>

<script>
  // Rozbaľovacie menu: otvára sa kliknutím, zatvára kliknutím mimo, Esc alebo výberom položky.
  const root = document.querySelector<HTMLElement>('.has-menu');
  const btn = root?.querySelector<HTMLButtonElement>('.nav-btn');
  const menu = root?.querySelector<HTMLElement>('.menu');

  if (root && btn && menu) {
    const open = () => {
      menu.hidden = false;
      requestAnimationFrame(() => root.classList.add('is-open'));
      btn.setAttribute('aria-expanded', 'true');
    };
    const close = () => {
      root.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
      menu.addEventListener('transitionend', () => { if (!root.classList.contains('is-open')) menu.hidden = true; }, { once: true });
    };
    const toggle = () => (root.classList.contains('is-open') ? close() : open());

    btn.addEventListener('click', (e) => { e.stopPropagation(); toggle(); });
    document.addEventListener('click', (e) => { if (!root.contains(e.target as Node)) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { close(); btn.focus(); } });
  }
</script>
