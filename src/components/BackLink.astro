---
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<a class="back" href={href}>
  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M10 3 5 8l5 5"/></svg>
  <span>{label}</span>
</a>
